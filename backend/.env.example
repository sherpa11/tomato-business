# ==============================================================
# Tomato Wholesale Billing & Tally System - Environment Configuration
# ==============================================================

# Application Environment: 'production', 'development', or 'test'
NODE_ENV=production

# Server Port (assigned by host or default 5000)
PORT=5000

# MongoDB Connection String (must include authentication and database name)
# Example: mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/tomato_billing?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/tomato_billing

# JWT Secret Key (REQUIRED: Must be a cryptographically strong, random string of at least 32 characters in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_production_jwt_secret_min_32_characters_long

# JWT Token Expiration (e.g. '7d', '24h', '12h')
JWT_EXPIRES_IN=7d

# CORS Allowed Origin for production frontend (e.g. https://mandi.yourdomain.com)
# For multiple comma-separated origins: https://mandi.yourdomain.com,https://admin.yourdomain.com
CORS_ORIGIN=http://localhost:3000

# Optional Chrome Executable Path (if custom location or on Linux server)
# Leave empty for standard auto-discovery
CHROME_PATH=

# Demo Data Seeding Flag (DEVELOPMENT / TEST ONLY)
# In production, this flag is strictly ignored and disabled.
# Set to 'false' in production.
SEED_DEMO_DATA=false
